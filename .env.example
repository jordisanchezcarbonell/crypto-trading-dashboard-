# =============================================================================
# Copy to .env.local and fill in. `.env*` is git-ignored.
# NEVER commit real values.
# =============================================================================

# --- Dashboard data source ---------------------------------------------------
# `mock`     serves the local fixture from lib/mock/run3-fixtures.ts.
# `supabase` reads from the Supabase observability replica (RLS, SELECT only).
# In production this variable is REQUIRED — the factory refuses to boot
# without it so we never accidentally serve mock data as if it were real.
DASHBOARD_DATA_SOURCE=mock

# --- Which run to display ----------------------------------------------------
# RUN-3-DEMO → synthetic seeded / mock development data (safe to overwrite).
# RUN-3      → RESERVED for real observability data published by the future
#              Hetzner exporter. This repo will NEVER write to it.
DASHBOARD_RUN_ID=RUN-3-DEMO

# --- Supabase (required when DASHBOARD_DATA_SOURCE=supabase) -----------------
# Public project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# ANON key. Public-safe. This is what the dashboard uses. RLS + revoked
# write grants make it strictly read-only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Seed / future exporter only (LOCAL DEV ONLY) ----------------------------
# SERVICE ROLE key. Bypasses RLS. Used by `npm run supabase:seed` here, and
# eventually by the Hetzner exporter — NEVER by the running dashboard.
#
# DO NOT set this variable on the Vercel deployment. If it leaks into the
# dashboard environment `createServerSupabaseClient()` will log a warning;
# the dashboard itself still uses the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for the seed script. Must end in "-DEMO"; must not be
# "RUN-3". The default is RUN-3-DEMO.
# DASHBOARD_SEED_RUN_ID=RUN-3-DEMO

# -----------------------------------------------------------------------------
# .env.anon.example — placeholder for the RLS verifier's isolated credential
# file (.env.anon.local). Copy this to .env.anon.local and fill in the values.
#
# ONLY these two variables are allowed. scripts/verify-anon-rls.mjs refuses to
# run if the file contains anything else — this is on purpose so the
# service-role key can never leak in via .env parsing.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

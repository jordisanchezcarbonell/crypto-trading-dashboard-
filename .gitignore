# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the placeholder templates MUST be tracked so contributors know what
# to set. Real values still land in .env.local / .env.anon.local (both
# matched by the .env* pattern above).
!.env.example
!.env.anon.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
# `.claude/worktrees/*` are git worktrees, so each one carries its own .git.
# Without this rule `git add -A` records the directory as a gitlink (mode
# 160000) with no .gitmodules to resolve it — a fresh clone then gets an
# empty directory and a submodule git reports as permanently modified.
# Settings marked `.local` are per-machine by convention; a shared
# .claude/settings.json is still tracked.
.claude/worktrees/
.claude/settings.local.json
